@model IReadOnlyList<ModerationQueueItem>
@{
    ViewData["Title"] = "Модерация";
}

<div class="page-head">
    <div>
        <h1 style="margin:0">Очередь модерации</h1>
        <p class="page-sub">@Model.Count объявлений на проверке</p>
    </div>
    <div class="page-actions">
        <a class="button button-secondary" asp-controller="Moderation" asp-action="Complaints">Жалобы</a>
    </div>
</div>

@if (Model.Count == 0)
{
    <partial name="_EmptyState" model='("Объявлений на проверке нет.", "", "", "")' />
}
else
{
    <div>
        @foreach (var item in Model)
        {
            <div class="queue-item">
                <div class="queue-main">
                    <span class="queue-address">@item.Address</span>
                    <span class="queue-meta">@item.Price.ToString("N0") ₽ · отправлено @item.CreatedAt.ToLocalTime().ToString("dd.MM HH:mm") · версия @item.Version</span>
                </div>
                <a class="button button-secondary button-small" asp-controller="Moderation" asp-action="Details" asp-route-id="@item.ListingId">Проверить</a>
            </div>
        }
    </div>
}
