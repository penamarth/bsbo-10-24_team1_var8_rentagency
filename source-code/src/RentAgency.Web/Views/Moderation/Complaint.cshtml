@model ModerationComplaintPageViewModel
@{
    ViewData["Title"] = "Жалоба";
    var complaint = Model.Complaint;
}

<a class="link-quiet" asp-controller="Moderation" asp-action="Complaints">← Жалобы</a>

<div class="section-head" style="margin-top:0.8rem">
    <h1 style="margin:0">Жалоба</h1>
    <span class="badge">@complaint.Status.ToRussian()</span>
</div>

<div class="split">
    <div class="stack">
        <section class="card">
            <h2>Суть</h2>
            <p>@complaint.Description</p>
            <p class="muted" style="margin:0">Цель: @Model.TargetLabel · подана @complaint.SubmittedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</p>
        </section>

        @if (complaint.Evidence.Count > 0)
        {
            <section class="card">
                <h2>Материалы</h2>
                <ul>
                    @foreach (var evidence in complaint.Evidence)
                    {
                        <li>
                            <a href="/complaints/@complaint.Id/evidence/@evidence.Id">@evidence.OriginalFileName</a>
                        </li>
                    }
                </ul>
            </section>
        }

        <section class="card">
            <h2>История</h2>

            @if (complaint.History.Count == 0)
            {
                <p class="empty">Обработки пока не было.</p>
            }
            else
            {
                <ul class="history">
                    @foreach (var item in complaint.History)
                    {
                        <li>
                            @item.HandledAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                            @if (!string.IsNullOrWhiteSpace(item.RequestedDetails))
                            {
                                <div>Запрошены уточнения: @item.RequestedDetails</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.Decision))
                            {
                                <div><strong>Решение:</strong> @item.Decision</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.Rationale))
                            {
                                <div class="muted">Обоснование: @item.Rationale</div>
                            }
                        </li>
                    }
                </ul>
            }
        </section>
    </div>

    <aside class="stack">
        <div class="card">
            <h2>Запросить уточнения</h2>
            <form asp-controller="Moderation" asp-action="RequestDetails" asp-route-id="@complaint.Id" method="post">
                <div class="field">
                    <label for="details">Что нужно уточнить</label>
                    <textarea id="details" name="details" required maxlength="2000"></textarea>
                </div>
                <button class="button button-secondary" type="submit">Запросить</button>
            </form>
        </div>

        <div class="card">
            <h2>Решение</h2>
            <form asp-controller="Moderation" asp-action="Resolve" asp-route-id="@complaint.Id" method="post">
                <div class="field">
                    <label for="decision">Решение</label>
                    <textarea id="decision" name="decision" required maxlength="2000"></textarea>
                </div>
                <div class="field">
                    <label for="rationale">Обоснование</label>
                    <textarea id="rationale" name="rationale" maxlength="2000"></textarea>
                </div>
                <button class="button" type="submit">Рассмотреть жалобу</button>
            </form>
        </div>
    </aside>
</div>
