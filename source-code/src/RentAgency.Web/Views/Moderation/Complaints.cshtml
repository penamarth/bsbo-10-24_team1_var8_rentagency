@model IReadOnlyList<ComplaintSummary>
@{
    ViewData["Title"] = "Жалобы";
}

<div class="page-head">
    <h1 style="margin:0">Жалобы</h1>
</div>

@if (Model.Count == 0)
{
    <partial name="_EmptyState" model='("Жалоб пока нет.", "", "", "")' />
}
else
{
    <div>
        @foreach (var complaint in Model)
        {
            <div class="queue-item">
                <div class="queue-main">
                    <span class="queue-address">@(complaint.TargetListingId is not null ? "Жалоба на объявление" : "Жалоба на пользователя")</span>
                    <span class="queue-meta">подана @complaint.SubmittedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                </div>
                <div style="display:flex; gap:0.7rem; align-items:center">
                    <span class="badge @RentAgency.Web.Infrastructure.StatusBadge.For(complaint.Status)">@complaint.Status.ToRussian()</span>
                    <a class="button button-secondary button-small" asp-controller="Moderation" asp-action="Complaint" asp-route-id="@complaint.Id">Открыть</a>
                </div>
            </div>
        }
    </div>
}
