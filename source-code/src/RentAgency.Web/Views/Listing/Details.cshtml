@model ListingDetailsPageViewModel
@{
    ViewData["Title"] = Model.Listing.Address;
    var listing = Model.Listing;
    var photos = listing.PhotoKeys;
}

<a class="link-quiet" asp-controller="Home" asp-action="Index">← Все объявления</a>

<div class="split" style="margin-top:0.8rem">
    <div class="stack">
        @if (photos.Count > 0)
        {
            <div class="photo-main">
                <img src="@PhotoUrls.Listing(photos[0])" alt="Фотография жилья" />
            </div>

            @if (photos.Count > 1)
            {
                <div class="photo-grid">
                    @foreach (var photo in photos.Skip(1))
                    {
                        <a href="@PhotoUrls.Listing(photo)" target="_blank" rel="noreferrer">
                            <img src="@PhotoUrls.Listing(photo)" alt="" loading="lazy" />
                        </a>
                    }
                </div>
            }
        }

        <section class="card">
            <h2>Описание</h2>
            <p>@listing.Description</p>

            <h3>Условия сдачи</h3>
            <p>@listing.RentalTerms</p>
        </section>
    </div>

    <aside class="stack aside-sticky">
        <div class="card">
            <h1 style="margin-bottom:0.4rem">@listing.Address</h1>
            <div class="price-line">@listing.Price.ToString("N0") ₽ <small>в месяц</small></div>
            <p class="muted" style="margin-top:0.4rem">
                @listing.Rooms комн. · @listing.Area.ToString("0.#") м² · доступно с @listing.AvailableFrom.ToString("dd.MM.yyyy")
            </p>

            @if (Model.IsOwner)
            {
                <p class="muted">Это ваше объявление.</p>
                <a class="button button-secondary" asp-controller="Owner" asp-action="Index">Мои объявления</a>
            }
            else if (!Model.IsAuthenticated)
            {
                <p class="muted">Войдите, чтобы отправить заявку.</p>
                <a class="button" asp-controller="Account" asp-action="Login">Войти</a>
            }
            else
            {
                <h3 style="margin-top:1rem">Откликнуться</h3>

                <form asp-controller="Rentals" asp-action="Apply" asp-route-listingId="@listing.ListingId" method="post">
                    <div asp-validation-summary="ModelOnly" class="validation"></div>

                    <div class="field">
                        <label asp-for="Apply.Message"></label>
                        <textarea asp-for="Apply.Message" placeholder="Коротко о себе и планах"></textarea>
                        <span asp-validation-for="Apply.Message" class="validation"></span>
                    </div>

                    <div class="inline-fields">
                        <div class="field">
                            <label asp-for="Apply.ProposedStart"></label>
                            <input asp-for="Apply.ProposedStart" type="date" />
                            <span asp-validation-for="Apply.ProposedStart" class="validation"></span>
                        </div>
                        <div class="field">
                            <label asp-for="Apply.ProposedEnd"></label>
                            <input asp-for="Apply.ProposedEnd" type="date" />
                            <span asp-validation-for="Apply.ProposedEnd" class="validation"></span>
                        </div>
                    </div>

                    <button class="button" type="submit">Отправить заявку</button>
                </form>

                <p style="margin-top:0.8rem">
                    <a class="link-quiet" asp-controller="Complaints" asp-action="Create" asp-route-listingId="@listing.ListingId">Пожаловаться на объявление</a>
                </p>
            }
        </div>
    </aside>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
