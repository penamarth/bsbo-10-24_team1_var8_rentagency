@model IReadOnlyList<ComplaintSummary>
@{
    ViewData["Title"] = "Мои жалобы";
}

<h1>Мои жалобы</h1>

@if (Model.Count == 0)
{
    <partial name="_EmptyState" model='("Жалоб пока нет. Пожаловаться можно со страницы объявления.", "К поиску", "Home", "Index")' />
}
else
{
    <div class="table-wrap" role="region" aria-label="Таблица данных" tabindex="0">
<table>
        <thead>
        <tr><th>Цель</th><th>Статус</th><th>Подана</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var complaint in Model)
        {
            <tr>
                <td>@(complaint.TargetListingId is not null ? "Объявление" : "Пользователь")</td>
                <td><span class="@StatusBadge.For(complaint.Status)">@complaint.Status.ToRussian()</span></td>
                <td>@complaint.SubmittedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                <td><a asp-controller="Complaints" asp-action="Details" asp-route-id="@complaint.Id">Открыть</a></td>
            </tr>
        }
        </tbody>
    </table>
</div>
}
