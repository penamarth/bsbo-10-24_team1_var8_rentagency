@model ListingFormViewModel
<form asp-controller="Owner" asp-action="@(Model.IsEdit ? "Edit" : "Create")" asp-route-id="@(Model.IsEdit ? Model.ListingId : null)" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Version" />
    <input type="hidden" asp-for="ListingId" />

    <div asp-validation-summary="ModelOnly" class="validation"></div>

    <div class="split">
        <div class="card">
            <div class="field">
                <label asp-for="Address"></label>
                <input asp-for="Address" placeholder="Улица, дом, район" />
                <span asp-validation-for="Address" class="validation"></span>
            </div>

            <div class="field">
                <label asp-for="Description"></label>
                <textarea asp-for="Description" placeholder="Что важно знать о квартире"></textarea>
                <span asp-validation-for="Description" class="validation"></span>
            </div>

            <div class="field">
                <label asp-for="RentalTerms"></label>
                <textarea asp-for="RentalTerms" placeholder="Сроки, залог, животные, коммуналка"></textarea>
                <span asp-validation-for="RentalTerms" class="validation"></span>
            </div>

            <div class="inline-fields">
                <div class="field">
                    <label asp-for="Price"></label>
                    <input asp-for="Price" type="number" min="1" />
                    <span asp-validation-for="Price" class="validation"></span>
                </div>
                <div class="field">
                    <label asp-for="Rooms"></label>
                    <input asp-for="Rooms" type="number" min="1" max="50" />
                    <span asp-validation-for="Rooms" class="validation"></span>
                </div>
                <div class="field">
                    <label asp-for="Area"></label>
                    <input asp-for="Area" type="number" min="1" step="0.1" />
                    <span asp-validation-for="Area" class="validation"></span>
                </div>
                <div class="field">
                    <label asp-for="AvailableFrom"></label>
                    <input asp-for="AvailableFrom" type="date" />
                    <span asp-validation-for="AvailableFrom" class="validation"></span>
                </div>
            </div>
        </div>

        <aside class="card aside-sticky">
            <div class="field">
                <label asp-for="Photos"></label>
                <input asp-for="Photos" type="file" name="Photos" multiple accept="image/jpeg,image/png,image/webp" />
                <span asp-validation-for="Photos" class="validation"></span>
                <p class="muted" style="font-size:0.85rem">
                    @(Model.IsEdit ? "Новые фотографии заменят текущие." : "От 1 до 8 фотографий, до 5 МБ каждая.")
                </p>
            </div>

            @if (Model.IsEdit && Model.ExistingPhotoKeys.Count > 0)
            {
                <div class="gallery-thumbs" style="margin-bottom:0.8rem">
                    @foreach (var photo in Model.ExistingPhotoKeys)
                    {
                        <a href="@PhotoUrls.Listing(photo)" target="_blank" rel="noreferrer">
                            <img src="@PhotoUrls.Listing(photo)" alt="" />
                        </a>
                    }
                </div>
            }

            <div class="form-actions">
                <button class="button" type="submit">@(Model.IsEdit ? "Отправить снова" : "Отправить на модерацию")</button>
            </div>
        </aside>
    </div>
</form>
