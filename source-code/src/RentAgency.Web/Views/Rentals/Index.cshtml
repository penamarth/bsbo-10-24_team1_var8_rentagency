@model RequestListViewModel
@{
    ViewData["Title"] = "Заявки";
}

<h1>Заявки</h1>

<section class="section">
    <h2>Мои отклики</h2>

    @if (Model.AsTenant.Count == 0)
    {
        <partial name="_EmptyState" model='("Вы ещё не откликались на объявления.", "Найти жильё", "Home", "Index")' />
    }
    else
    {
        <div class="table-wrap" role="region" aria-label="Таблица данных" tabindex="0">
<table>
            <thead>
            <tr><th>Жильё</th><th>Статус</th><th>Создана</th><th></th></tr>
            </thead>
            <tbody>
            @foreach (var request in Model.AsTenant)
            {
                <tr>
                    <td>@request.Address</td>
                    <td><span class="@StatusBadge.For(request.Status)">@request.Status.ToRussian()</span></td>
                    <td>@request.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                    <td><a asp-controller="Rentals" asp-action="Details" asp-route-id="@request.RequestId">Открыть</a></td>
                </tr>
            }
            </tbody>
        </table>
</div>
    }
</section>

@if (Model.AsOwner.Count > 0)
{
    <section class="section">
        <h2>Заявки на мои объявления</h2>
        <div class="table-wrap" role="region" aria-label="Таблица данных" tabindex="0">
<table>
            <thead>
            <tr><th>Жильё</th><th>Статус</th><th>Создана</th><th></th></tr>
            </thead>
            <tbody>
            @foreach (var request in Model.AsOwner)
            {
                <tr>
                    <td>@request.Address</td>
                    <td><span class="@StatusBadge.For(request.Status)">@request.Status.ToRussian()</span></td>
                    <td>@request.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                    <td><a asp-controller="Rentals" asp-action="Details" asp-route-id="@request.RequestId">Открыть</a></td>
                </tr>
            }
            </tbody>
        </table>
</div>
    </section>
}
