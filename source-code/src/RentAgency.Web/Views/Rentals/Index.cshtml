@model RequestListViewModel
@{
    ViewData["Title"] = "Заявки";
    var tab = ViewData["Tab"] as string ?? "tenant";
    var isTenant = tab != "owner";
    var items = isTenant ? Model.AsTenant : Model.AsOwner;
}

<div class="page-head">
    <h1 style="margin:0">Заявки</h1>
    <a class="button button-secondary" asp-controller="Home" asp-action="Index">Найти жильё</a>
</div>

<nav class="tabs" aria-label="Тип заявок">
    <a class="tab" asp-controller="Rentals" asp-action="Index" asp-route-tab="tenant" aria-current="@(isTenant ? "page" : null)">Мои отклики</a>
    <a class="tab" asp-controller="Rentals" asp-action="Index" asp-route-tab="owner" aria-current="@(isTenant ? null : "page")">На мои объявления</a>
</nav>

@if (items.Count == 0)
{
    <partial name="_EmptyState" model='(isTenant
        ? "Вы ещё не откликались на объявления."
        : "Заявок на ваши объявления пока нет.",
        isTenant ? "Найти жильё" : "", "Home", "Index")' />
}
else
{
    <div class="table-wrap" role="region" aria-label="Список заявок" tabindex="0">
        <table>
            <thead>
            <tr><th>Жильё</th><th>Статус</th><th>Создана</th><th></th></tr>
            </thead>
            <tbody>
            @foreach (var request in items)
            {
                <tr>
                    <td>@request.Address</td>
                    <td><span class="badge @RentAgency.Web.Infrastructure.StatusBadge.For(request.Status)">@request.Status.ToRussian()</span></td>
                    <td>@request.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                    <td><a asp-controller="Rentals" asp-action="Details" asp-route-id="@request.RequestId">Открыть</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
