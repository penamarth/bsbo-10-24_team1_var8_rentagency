@model RegisterViewModel
@{
    ViewData["Title"] = "Регистрация";
}

<div class="narrow">
    <div class="card">
        <h1>Регистрация</h1>
        <p class="muted">Аккаунт арендатора. Арендодателем можно стать позже в один клик.</p>

        <form asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="validation"></div>

            <div class="field">
                <label asp-for="Name"></label>
                <input asp-for="Name" autocomplete="name" />
                <span asp-validation-for="Name" class="validation"></span>
            </div>

            <div class="field">
                <label asp-for="ContactDetails"></label>
                <input asp-for="ContactDetails" autocomplete="tel" placeholder="Телефон или другой контакт" />
                <span asp-validation-for="ContactDetails" class="validation"></span>
            </div>

            <div class="field">
                <label asp-for="Email"></label>
                <input asp-for="Email" autocomplete="email" />
                <span asp-validation-for="Email" class="validation"></span>
            </div>

            <div class="field">
                <label asp-for="Password"></label>
                <input asp-for="Password" autocomplete="new-password" />
                <span asp-validation-for="Password" class="validation"></span>
            </div>

            <div class="field">
                <label asp-for="ConfirmPassword"></label>
                <input asp-for="ConfirmPassword" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="validation"></span>
            </div>

            <button type="submit" class="button" style="width:100%">Зарегистрироваться</button>
        </form>
    </div>

    <p class="muted" style="text-align:center; margin-top:0.9rem">
        Уже есть аккаунт? <a asp-action="Login">Войти</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
