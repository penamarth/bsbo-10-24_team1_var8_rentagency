@model IReadOnlyList<Notification>
@{
    ViewData["Title"] = "Уведомления";
}

<h1>Уведомления</h1>

@if (Model.Count == 0)
{
    <p class="empty">Уведомлений пока нет.</p>
}
else
{
    <div class="stack">
        @foreach (var notification in Model)
        {
            <div class="card">
                <div>@notification.Text</div>
                <div class="muted" style="font-size:0.85rem">@notification.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
            </div>
        }
    </div>
}
