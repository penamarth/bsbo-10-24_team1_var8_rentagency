@model LoginViewModel
@{
    ViewData["Title"] = "Вход";
}

<div class="narrow">
    <div class="card">
        <h1>Вход</h1>
        <p class="muted">С возвращением.</p>

        <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
            <div asp-validation-summary="ModelOnly" class="validation"></div>

            <div class="field">
                <label asp-for="Email"></label>
                <input asp-for="Email" autocomplete="email" />
                <span asp-validation-for="Email" class="validation"></span>
            </div>

            <div class="field">
                <label asp-for="Password"></label>
                <input asp-for="Password" autocomplete="current-password" />
                <span asp-validation-for="Password" class="validation"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe"></label>
            </div>

            <button type="submit" class="button" style="width:100%">Войти</button>
        </form>
    </div>

    <p class="muted" style="text-align:center; margin-top:0.9rem">
        Нет аккаунта? <a asp-action="Register">Зарегистрироваться</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
